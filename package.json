{
  "name": "ai-performance-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted performance testing platform",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "db:migrate": "node scripts/migrate.cjs",
