PORT=3000
AUTH_MODE=local-mock
NODE_ENV=development
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/ai_performance_agent?sslmode=disable
# Set positive integers approved for your environment before creating draft scripts.
# There are no default workload ceilings.
MAX_VIRTUAL_USERS=
MAX_DURATION_SECONDS=

# Phase 3 AI provider: Groq. Fill the API key in .env only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_MS=30000

# Phase 4: approved request ceilings are mandatory; no load limits are guessed.
MAX_REQUESTS_PER_SECOND=
MAX_REQUESTS_PER_RUN=
MAX_CONCURRENT_RUNS=5
REDIS_URL=redis://127.0.0.1:6379/0
# Stable and unique for each Docker daemon; retain it across worker restarts.
WORKER_HOST_ID=local-docker
K6_WORKER_IMAGE=performance-k6:1.8.2-phase5
WORKER_CPUS=1
WORKER_MEMORY_MB=512
WORKER_PIDS_LIMIT=128

# Phase 5 local artifacts and durable result staging (Cloud Storage pending).
ARTIFACT_STORAGE=local
ARTIFACTS_DIR=.local/artifacts
RESULT_STAGING_DIR=.local/result-staging
MAX_ARTIFACT_BYTES=33554432
MAX_EXPORT_BYTES=67108864
ARTIFACT_LINK_TTL_SECONDS=60
# At least 32 characters; blank uses a per-process random secret in local mode.
ARTIFACT_SIGNING_SECRET=
# Approved local policy: manual deletion, 2-day lead time for any future scheduled deletion.
AUTOMATIC_RETENTION_APPROVED=false
RETENTION_NOTICE_DAYS=2
# Future recipient only. In-app notices are used; no email is sent.
NOTIFICATION_EMAIL=
EMAIL_PROVIDER=disabled
