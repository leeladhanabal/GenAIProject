{
  "name": "ai-performance-agent",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted performance testing platform",
  "scripts": {
    "build": "nest build && npm run build:worker && npm run build:web",
    "build:worker": "tsc --project apps/worker/tsconfig.json",
    "start:worker": "node dist-worker/worker/src/main.js",
    "start:phase5": "node dist-worker/worker/src/phase5-main.js",
    "phase5:seed": "node dist-worker/worker/src/seed-phase5.js",
    "build:web": "vite build apps/web --config apps/web/vite.config.mjs",
    "start:web": "vite apps/web --config apps/web/vite.config.mjs",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "db:migrate": "node scripts/migrate.cjs",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint \"apps/api/src/**/*.ts\" \"apps/worker/src/**/*.ts\" \"apps/web/src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit && tsc --project apps/web/tsconfig.json"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "bullmq": "^6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.13.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.19.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "^8.3.5"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
